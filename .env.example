# =============================================================================
# Prestige — local development environment template
# Copy this file to `.env` and fill in values you actually need.
# Never commit real secrets to this file. Production values live in Railway.
# =============================================================================

# Runtime
NODE_ENV=development
PORT=3000

# Database (MySQL 8). Leave empty to run without persistence — DB-backed
# features (dashboard charts, tracking, telegram tables) will then no-op.
# To enable persistence locally with Docker:
#   docker run --name prestige-mysql -e MYSQL_ROOT_PASSWORD=rootpass \
#     -e MYSQL_DATABASE=prestige -p 3306:3306 -d mysql:8
DATABASE_URL=mysql://root:rootpass@127.0.0.1:3306/prestige

# Cookie / JWT signing — production must use a unique random hex (set in Railway).
JWT_SECRET=local-dev-jwt-secret-change-me

# Local-only dashboard password. Production must override (set in Railway).
DASHBOARD_PASSWORD=1234

# Telegram (optional locally — workers no-op without these)
# Set TELEGRAM_BOT_USERNAME and TELEGRAM_BOT_TOKEN to a *test* bot, never the
# production bot. Channel ID and group URL likewise must point to a test channel.
TELEGRAM_BOT_USERNAME=<SET_ME>
TELEGRAM_BOT_TOKEN=<SET_ME>
TELEGRAM_WEBHOOK_SECRET=<SET_ME>
TELEGRAM_WEBHOOK_URL=<SET_ME>
TELEGRAM_GROUP_URL=<SET_ME>
TELEGRAM_CHANNEL_ID=<SET_ME>
# WhatsApp channel the bot DM / reminders point users to via the /wa-go
# redirect (this click is the new Lead conversion). The site_settings key
# `whatsapp_channel_url` (admin-editable) overrides this at runtime; if both
# are unset /wa-go falls back to the Telegram group URL and logs a warning.
WHATSAPP_CHANNEL_URL=https://whatsapp.com/channel/0029Vb60PxI7YSd5pqwOq82R
# Public base used to build the personal {BASE}/wa-go links. Falls back to
# https://${RAILWAY_PUBLIC_DOMAIN} then APP_BASE_URL when unset.
WHATSAPP_REDIRECT_BASE_URL=<SET_ME>

# Comma-separated bare usernames (no @) authorized to run /rapport and to
# receive scheduled admin reports.
TELEGRAM_ADMIN_USERNAMES=

# Meta / Facebook Conversions API (optional)
# Both pixel IDs must match. Use a *test* pixel locally; production pixel lives
# only in Railway.
META_PIXEL_ID=<SET_ME>
VITE_META_PIXEL_ID=<SET_ME>
META_CONVERSIONS_TOKEN=<SET_ME>
# Set when you want CAPI events flagged as test events on the Meta side.
META_TEST_EVENT_CODE=

# OAuth (set OAUTH_SERVER_URL to the public app origin in production)
VITE_OAUTH_PORTAL_URL=
VITE_APP_ID=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=

# Frontend analytics (optional)
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# Manus Forge proxy (optional, frontend + backend)
VITE_FRONTEND_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
BUILT_IN_FORGE_API_URL=

# Set to "false" to disable workers on a non-leader replica.
WORKERS_ENABLED=true
